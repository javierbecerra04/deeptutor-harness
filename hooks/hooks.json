{
  "description": "Quiet in sessions with no tutoring. Restores tutoring state after compaction, logs study sessions for memory, and shows one notice when reviews are due.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/dtutor\" hook session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(dtutor *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/dtutor\" hook post-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/dtutor\" hook session-end",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
